# Host publish port. Containers talk on kafka:29092; host apps use localhost:19092
KAFKA_HOST_PORT=19092
KAFKA_BOOTSTRAP=localhost:19092
KAFKA_TOPIC=analytics.events
KAFKA_GROUP_ID=bq-sink
KAFKA_NUM_PARTITIONS=3

PRODUCER_EVENTS=30
PRODUCER_INTERVAL_MS=150

SINK_MODE=file
FILE_SINK_PATH=out/events.ndjson
SINK_BATCH_SIZE=10
SINK_LINGER_MS=1500
SINK_IDLE_STOP_POLLS=8

DEBUG_PORT=5005
PRODUCER_DEBUG_PORT=5006
DEBUG_SUSPEND=y

BQ_PROJECT=
BQ_DATASET=analytics
BQ_TABLE=events
